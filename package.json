    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "check:lifecycle": "tsx scripts/lifecycle-check.ts",
    "check:realtime": "tsx scripts/realtime-check.ts",
    "check:pages": "tsx scripts/page-check.ts",
    "test:e2e": "tsx scripts/e2e.ts"
  },
