# ---------------------------------------------------------------------------
# Auctioneer environment
# Copy to `.env` and adjust. Defaults line up with docker-compose.yml.
# ---------------------------------------------------------------------------

# Postgres (docker-compose maps 5432 -> 5433 to avoid clashing with a local pg)
DATABASE_URL="postgresql://auctioneer:auctioneer@localhost:5433/auctioneer"

# Redis (docker-compose maps 6379 -> 6380)
REDIS_URL="redis://localhost:6380"

# Better Auth. Generate a real secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="dev-only-secret-change-me-in-production-00000"
BETTER_AUTH_URL="http://localhost:3000"

# Public origin used by the browser to reach the app + realtime gateway.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# MinIO / S3-compatible object storage for lot images
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="auctioneer-media"
S3_ACCESS_KEY_ID="auctioneer"
S3_SECRET_ACCESS_KEY="auctioneer-secret"
S3_PUBLIC_URL="http://localhost:9000/auctioneer-media"

# Auction engine tuning
ANTISNIPE_WINDOW_SECONDS=120
ANTISNIPE_EXTENSION_SECONDS=120
BUYERS_PREMIUM_BPS=1000
ANTISNIPE_MAX_EXTENSIONS=30
